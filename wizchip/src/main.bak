#include "stm32f1xx.h"
#include "HSE_CLK.h"
#include <stdint.h>
#include "I2C.h"
#include "../drivers/uart.h"
#include "../drivers/delay.h"
#include <string.h>

static void delay_ms(uint32_t ms);

// I2C Scanner function
void i2c_scanner(void) {
    uint8_t address;
    uint8_t found_devices = 0;

    uart1_print("\r\n\r\nI2C Scanner Starting...\r\n");
    uart1_print("Scanning I2C bus for devices...\r\n\r\n");

    // Scan addresses 0x00 to 0x7F
    for (address = 0x00; address < 0x80; address++) {
        // Try to start communication with this address
        uint8_t result = i2c_start(address << 1); // I2C addresses are 7-bit, shift left for write

        if (result == 0) { // ACK received (device found)
            uart1_print("Found device at address: ");
            uart1_print_hex(address);
            uart1_print(" (0x");
            uart1_print_hex(address);
            uart1_print(")\r\n");
            found_devices++;
        }

        i2c_stop();
        delay_ms(5); // Small delay between scans
    }

    uart1_print("\r\nScan complete!\r\n");
    uart1_print("Found ");
    // Print number of devices (simple implementation)
    if (found_devices == 0) {
        uart1_print("0");
    } else if (found_devices == 1) {
        uart1_print("1");
    } else {
        // For simplicity, just print the count as hex
        uart1_print_hex(found_devices);
    }
    uart1_print(" device(s)\r\n\r\n");
}

int main(void) {
    // Initialize system clock
    X_Clock_Init();

    // Initialize UART for printing results
    uart1_init();

    // Initialize I2C
    i2c_init();

    uart1_print("STM32F103 I2C Scanner\r\n");
    uart1_print("===================\r\n");

    while (1) {
        // Run I2C scanner
        i2c_scanner();

        // Wait 5 seconds before next scan
        uart1_print("Waiting 5 seconds before next scan...\r\n");
        delay_ms(5000);
    }

    return 0;
}

static void delay_ms(uint32_t ms)
{
   while (ms-- != 0U)
   {
      for (volatile uint32_t cycles = 0U; cycles < 9000U; ++cycles)
      {
         __asm volatile("nop");
      }
   }
}

      if (eir & EIR_RXERIF) {
         // Receive error occurred
         // Clear the receive error interrupt flag
         enc28j60WriteOp(ENC28J60_BIT_FIELD_CLR, EIR, EIR_RXERIF);
      }
   }
}

void HAL_IncTick(void)
{
   systick_ms++;
}

uint32_t HAL_GetTick(void)
{
   return systick_ms;
}







